ARG MCP_BASE_IMAGE=weknora-mcp:arm64-152
FROM ${MCP_BASE_IMAGE}
WORKDIR /app
# Reuse the installed dependencies; upstream has not changed their constraints.
COPY mcp-server/ .
# The cached image already installs this directory as an editable package.
RUN python -m compileall -q . && pip check
CMD ["weknora-mcp-server", "--transport", "http", "--host", "0.0.0.0", "--port", "8000"]
